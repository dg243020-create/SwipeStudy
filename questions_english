  { label: "【英語・高校受験】", q: "I visited my uncle ( ) the summer vacation. 空所に入る語は？", choices: ["during", "while", "since"], answer: 0, explain: "during の後ろは名詞（期間）。while の後ろは「主語＋動詞」" },
  { label: "【英語・高校受験】", q: "You can't get in ( ) you have a ticket. 空所に入る語は？", choices: ["unless", "until", "although"], answer: 0, explain: "unless は「〜でない限り」。（チケットがない限り、入れない）" },
  { label: "【英語・高校受験】", q: "I don't know ( ) he will come or not. 空所に入る語は？", choices: ["whether", "weather", "whenever"], answer: 0, explain: "whether は「〜かどうか」。weather は「天気」で、発音は同じ" },
  { label: "【英語・高校受験】", q: "「either A or B」の意味は？", choices: ["AもBも", "AでもBでもない", "AかBのどちらか"], answer: 2, explain: "You can have either tea or coffee.（紅茶かコーヒーのどちらかが飲めます）" },
  { label: "【英語・高校受験】", q: "「neither」の意味は？", choices: ["どちらか", "どちらも〜ない", "どちらも"], answer: 1, explain: "Neither of them came.（彼らのどちらも来なかった）" },
  { label: "【英語・高校受験】", q: "「whenever」の意味は？", choices: ["〜のあいだ", "〜する前に", "〜するときはいつでも"], answer: 2, explain: "Call me whenever you need help.（助けが必要なときはいつでも電話して）" },
  { label: "【英語・高校受験】", q: "「vegetable」の意味は？", choices: ["果物", "野菜", "植物"], answer: 1, explain: "Eat more vegetables.（もっと野菜を食べなさい）" },
  { label: "【英語・高校受験】", q: "「luggage」の意味は？", choices: ["（旅行の）手荷物", "言語", "小包"], answer: 0, explain: "I lost my luggage.（手荷物をなくした）。数えられない名詞で、two pieces of luggage のように数える" },
  { label: "【英語・高校受験】", q: "「薬」を表す英単語は？", choices: ["medicine", "medium", "medal"], answer: 0, explain: "Take this medicine twice a day.（この薬を1日2回飲みなさい）" },
  { label: "【英語・高校受験】", q: "「けが」を表す英単語は？", choices: ["justice", "industry", "injury"], answer: 2, explain: "He had a serious injury.（彼は重傷を負った）" },
  { label: "【英語・高校受験】", q: "「scene」の意味は？", choices: ["場面、光景", "科学", "季節"], answer: 0, explain: "the last scene of the movie（映画の最後の場面）" },
  { label: "【英語・高校受験】", q: "「要求（する）、頼みごと」を表す英単語は？", choices: ["request", "respect", "rescue"], answer: 0, explain: "He made a request.（彼は頼みごとをした）" },
  { label: "【英語・高校受験】", q: "「tourist」の意味は？", choices: ["観光客", "地元の人", "運転手"], answer: 0, explain: "Many tourists visit Kyoto.（多くの観光客が京都を訪れる）" },
  { label: "【英語・高校受験】", q: "「shortage」の意味は？", choices: ["不足", "短所", "短縮"], answer: 0, explain: "a water shortage（水不足）" },
  { label: "【英語・高校受験】", q: "「ancient」の意味は？", choices: ["正確な", "古代の", "年に1度の"], answer: 1, explain: "ancient Rome（古代ローマ）" },
  { label: "【英語・高校受験】", q: "「achieve」の意味は？", choices: ["〜を達成する", "〜に到着する", "〜を調整する"], answer: 0, explain: "She achieved her goal.（彼女は目標を達成した）。名詞は achievement" },
  { label: "【英語・高校受験】", q: "「remain」の意味は？", choices: ["〜を思い出す", "〜を取り除く", "〜のままである、残る"], answer: 2, explain: "Please remain seated.（座ったままでいてください）" },
  { label: "【英語・高校受験】", q: "「gather」の意味は？", choices: ["〜を分ける", "〜を集める、集まる", "〜を育てる"], answer: 1, explain: "Students gathered in the hall.（生徒たちがホールに集まった）" },

// ===== 英語（高校受験）101〜200問 =====
  { label: "【英語・高校受験】", q: "「for example」の意味は？", choices: ["その結果", "例えば", "つまり"], answer: 1, explain: "I like sports, for example, tennis and soccer.（私はスポーツが好きで、例えばテニスやサッカーが好きだ）" },
  { label: "【英語・高校受験】", q: "「as well as 〜」の意味は？", choices: ["〜の代わりに", "〜だけでなく…も", "〜のあとで"], answer: 1, explain: "She speaks English as well as French.（彼女はフランス語だけでなく英語も話す）" },
  { label: "【英語・高校受験】", q: "「in front of 〜」の意味は？", choices: ["〜の後ろに", "〜の前に（場所）", "〜の中に"], answer: 1, explain: "There is a bus stop in front of the school.（学校の前にバス停がある）。時間の「前に」は before" },
  { label: "【英語・高校受験】", q: "「look forward to 〜ing」の意味は？", choices: ["〜を楽しみに待つ", "〜を探す", "〜を見守る"], answer: 0, explain: "I'm looking forward to seeing you.（あなたに会えるのを楽しみにしている）。to の後ろは動名詞（〜ing）" },
  { label: "【英語・高校受験】", q: "「〜の世話をする」を表す英語は？", choices: ["take part in", "take off", "take care of"], answer: 2, explain: "She takes care of her little brother.（彼女は弟の世話をする）。look after とほぼ同じ意味" },
  { label: "【英語・高校受験】", q: "「be good at 〜」の意味は？", choices: ["〜が好きだ", "〜が得意だ", "〜に飽きている"], answer: 1, explain: "He is good at math.（彼は数学が得意だ）。反対は be poor at 〜" },
  { label: "【英語・高校受験】", q: "I ( ) play tennis when I was a child. 空所に入る語（句）は？", choices: ["use to", "am used to", "used to"], answer: 2, explain: "used to 〜 は「以前は〜したものだ」。be used to 〜ing は「〜に慣れている」" },
  { label: "【英語・高校受験】", q: "「たくさんの」を表す英語は？", choices: ["a little", "a few", "a lot of"], answer: 2, explain: "We have a lot of rain in June.（6月は雨がたくさん降る）。肯定文でよく使う" },
  { label: "【英語・高校受験】", q: "「at least」の意味は？", choices: ["せいぜい", "少なくとも", "とうとう"], answer: 1, explain: "You should sleep at least seven hours.（少なくとも7時間は眠るべきだ）。「せいぜい」は at most" },
  { label: "【英語・高校受験】", q: "「by the way」の意味は？", choices: ["とにかく", "ところで", "そのうえ"], answer: 1, explain: "By the way, what time is it?（ところで、今何時ですか）。話題を変えるときに使う" },
  { label: "【英語・高校受験】", q: "Let's go to the sea ( ) the mountains. 空所に入る語（句）は？", choices: ["because of", "as well as", "instead of"], answer: 2, explain: "instead of 〜 は「〜の代わりに」。（山の代わりに海へ行こう）" },
  { label: "【英語・高校受験】", q: "「in fact」の意味は？", choices: ["実は、実際に", "例えば", "結局"], answer: 0, explain: "He looks young, but in fact he is fifty.（彼は若く見えるが、実は50歳だ）" },
  { label: "【英語・高校受験】", q: "「of course」の意味は？", choices: ["もちろん", "とうとう", "たぶん"], answer: 0, explain: "Of course, you can use my pen.（もちろん、私のペンを使っていいよ）" },
  { label: "【英語・高校受験】", q: "「〜のために（原因・理由）」を表す英語は？", choices: ["because", "because of", "although"], answer: 1, explain: "We stayed home because of the rain.（雨のために私たちは家にいた）。because の後ろは「主語＋動詞」、because of の後ろは名詞" },
  { label: "【英語・高校受験】", q: "「as soon as 〜」の意味は？", choices: ["〜するとすぐに", "〜するかぎり", "〜するまで"], answer: 0, explain: "Call me as soon as you arrive.（着いたらすぐに電話して）" },
  { label: "【英語・高校受験】", q: "「あきらめる」を表す英語は？", choices: ["give in", "give up", "give out"], answer: 1, explain: "Don't give up!（あきらめないで）。give up 〜ing で「〜することをあきらめる」" },
  { label: "【英語・高校受験】", q: "「look for 〜」の意味は？", choices: ["〜を見る", "〜を見守る", "〜を探す"], answer: 2, explain: "I'm looking for my key.（鍵を探している）。look at 〜 は「〜を見る」" },
  { label: "【英語・高校受験】", q: "「〜に参加する」を表す英語は？", choices: ["take part in", "take care of", "take place in"], answer: 0, explain: "Many students took part in the festival.（多くの生徒が祭りに参加した）。participate in と同じ意味" },
  { label: "【英語・高校受験】", q: "「get along with 〜」の意味は？", choices: ["〜と仲良くやっていく", "〜と別れる", "〜に追いつく"], answer: 0, explain: "I get along with my classmates.（私はクラスメートと仲良くやっている）" },
  { label: "【英語・高校受験】", q: "We have ( ) milk. Let's buy some more. 空所に入る語（句）は？", choices: ["run into", "run out of", "run away"], answer: 1, explain: "run out of 〜 は「〜を使い果たす」。（牛乳を切らした。もっと買おう）" },
  { label: "【英語・高校受験】", q: "「come up with 〜」の意味は？", choices: ["〜を思いつく", "〜に追いつく", "〜を訪ねる"], answer: 0, explain: "She came up with a good idea.（彼女はいい考えを思いついた）" },
  { label: "【英語・高校受験】", q: "「make sure」の意味は？", choices: ["〜を作り直す", "確かめる、確実にする", "〜を安全にする"], answer: 1, explain: "Make sure the door is locked.（ドアに鍵がかかっているか確かめて）" },
  { label: "【英語・高校受験】", q: "「〜を消す」を表す英語は？", choices: ["turn on", "turn up", "turn off"], answer: 2, explain: "Please turn off the TV.（テレビを消してください）。turn on は「〜をつける」" },
  { label: "【英語・高校受験】", q: "「put on 〜」の意味は？", choices: ["〜を身につける", "〜を脱ぐ", "〜をしまう"], answer: 0, explain: "Put on your coat. It's cold.（コートを着なさい。寒いよ）。put on は着る動作、wear は着ている状態" },
  { label: "【英語・高校受験】", q: "「pick up 〜」の意味は？", choices: ["〜を拾う、迎えに行く", "〜を置く", "〜を運ぶ"], answer: 0, explain: "I'll pick you up at the station.（駅へ迎えに行くよ）" },
  { label: "【英語・高校受験】", q: "「〜を調べて知る、見つけ出す」を表す英語は？", choices: ["look out", "find out", "work out"], answer: 1, explain: "I found out the truth.（私は真実を知った）。look for は「探す」、find out は「調べて知る」" },
  { label: "【英語・高校受験】", q: "「fall asleep」の意味は？", choices: ["目を覚ます", "夢を見る", "眠りに落ちる"], answer: 2, explain: "I fell asleep on the train.（私は電車で眠ってしまった）" },
  { label: "【英語・高校受験】", q: "The train left ( ) time, exactly at nine. 空所に入る語（句）は？", choices: ["on", "in", "at"], answer: 0, explain: "on time は「時間どおりに」。in time は「間に合って」" },
  { label: "【英語・高校受験】", q: "I got to the airport just ( ) time for my flight. 空所に入る語（句）は？", choices: ["on", "at", "in"], answer: 2, explain: "in time (for 〜) は「〜に間に合って」" },
  { label: "【英語・高校受験】", q: "「so far」の意味は？", choices: ["とても遠くに", "今までのところ", "もうすぐ"], answer: 1, explain: "So far, I haven't had any problems.（今までのところ、問題はない）。現在完了形とよく使う" },
  { label: "【英語・高校受験】", q: "Kyoto is ( ) its old temples. 空所に入る語（句）は？", choices: ["famous as", "famous of", "famous for"], answer: 2, explain: "be famous for 〜 は「〜で有名だ」。be famous as 〜 は「〜として有名だ」" },
  { label: "【英語・高校受験】", q: "「be afraid of 〜」の意味は？", choices: ["〜を恐れる", "〜を恥じる", "〜に飽きる"], answer: 0, explain: "She is afraid of dogs.（彼女は犬が怖い）" },
  { label: "【英語・高校受験】", q: "「〜に興味がある」を表す英語は？", choices: ["be interested in", "be surprised at", "be tired of"], answer: 0, explain: "I'm interested in history.（私は歴史に興味がある）。be surprised at 〜 は「〜に驚く」、be tired of 〜 は「〜にうんざりしている」" },
  { label: "【英語・高校受験】", q: "「would like to 〜」の意味は？", choices: ["〜するべきだ", "〜したことがある", "〜したい（ていねいな言い方）"], answer: 2, explain: "I would like to ask a question.（質問したいのですが）。want to 〜 よりていねい" },
  { label: "【英語・高校受験】", q: "She can speak ( ) English but also French. 空所に入る語（句）は？", choices: ["both", "either", "not only"], answer: 2, explain: "not only A but also B で「AだけでなくBも」" },
  { label: "【英語・高校受験】", q: "「too 〜 to …」の意味は？", choices: ["〜するのに十分…だ", "〜すぎて…できない", "とても〜なので…だ"], answer: 1, explain: "He is too tired to walk.（彼は疲れすぎて歩けない）。enough to 〜 は「〜するのに十分」" },
  { label: "【英語・高校受験】", q: "「each other」の意味は？", choices: ["お互い", "それぞれ別々に", "どちらか一方"], answer: 0, explain: "They help each other.（彼らはお互いに助け合っている）" },
  { label: "【英語・高校受験】", q: "「all over the world」の意味は？", choices: ["世界の終わりに", "世界一", "世界中で"], answer: 2, explain: "This singer is famous all over the world.（この歌手は世界中で有名だ）" },
  { label: "【英語・高校受験】", q: "「at first」の意味は？", choices: ["最初は", "ついに", "最後に"], answer: 0, explain: "At first, I didn't like it.（最初は、それが好きではなかった）。「ついに」は at last" },
  { label: "【英語・高校受験】", q: "「after all」の意味は？", choices: ["何よりも", "すべての後に", "結局、やはり"], answer: 2, explain: "He didn't come after all.（結局、彼は来なかった）" },
  { label: "【英語・高校受験】", q: "「accept」の意味は？", choices: ["〜を断る", "〜を受け入れる", "〜を例外とする"], answer: 1, explain: "She accepted the invitation.（彼女は招待を受け入れた）" },
  { label: "【英語・高校受験】", q: "「admit」の意味は？", choices: ["〜を提出する", "〜を認める", "〜を禁止する"], answer: 1, explain: "He admitted his mistake.（彼は自分の間違いを認めた）" },
  { label: "【英語・高校受験】", q: "You should ( ) eating too much sugar. 空所に入る語（句）は？", choices: ["admit", "allow", "avoid"], answer: 2, explain: "avoid は後ろに〜ing をとる。（砂糖をとりすぎるのは避けたほうがいい）" },
  { label: "【英語・高校受験】", q: "「belong to 〜」の意味は？", choices: ["〜に所属する", "〜を信じる", "〜に勝つ"], answer: 0, explain: "I belong to the tennis club.（私はテニス部に所属している）" },
  { label: "【英語・高校受験】", q: "The concert was ( ) because of the typhoon. 空所に入る語（句）は？", choices: ["celebrated", "collected", "canceled"], answer: 2, explain: "cancel は「〜を取り消す」。（台風のため、コンサートは中止になった）" },
  { label: "【英語・高校受験】", q: "「〜を祝う」を表す英語は？", choices: ["collect", "calculate", "celebrate"], answer: 2, explain: "We celebrated her birthday.（私たちは彼女の誕生日を祝った）" },
  { label: "【英語・高校受験】", q: "「collect」の意味は？", choices: ["〜を選ぶ", "〜を集める", "〜を直す"], answer: 1, explain: "He collects stamps.（彼は切手を集めている）" },
  { label: "【英語・高校受験】", q: "「compare」の意味は？", choices: ["〜を準備する", "〜を修理する", "〜を比較する"], answer: 2, explain: "Don't compare yourself with others.（他人と自分を比べないで）。compare A with B" },
  { label: "【英語・高校受験】", q: "「complain」の意味は？", choices: ["不平を言う", "〜を完成する", "〜を包む"], answer: 0, explain: "He always complains about the food.（彼はいつも食べ物に文句を言う）" },
  { label: "【英語・高校受験】", q: "「connect」の意味は？", choices: ["〜を制限する", "〜をつなぐ", "〜を切る"], answer: 1, explain: "This bridge connects the two islands.（この橋は2つの島をつなぐ）" },
  { label: "【英語・高校受験】", q: "「〜を続ける」を表す英語は？", choices: ["contain", "continue", "contact"], answer: 1, explain: "Please continue your story.（話を続けてください）" },
  { label: "【英語・高校受験】", q: "「destroy」の意味は？", choices: ["〜を設計する", "〜を描く", "〜を破壊する"], answer: 2, explain: "The storm destroyed many houses.（嵐で多くの家が壊れた）" },
  { label: "【英語・高校受験】", q: "「消える、見えなくなる」を表す英語は？", choices: ["disagree", "discover", "disappear"], answer: 2, explain: "The sun disappeared behind the clouds.（太陽が雲の後ろに消えた）" },
  { label: "【英語・高校受験】", q: "「discuss」の意味は？", choices: ["〜を発見する", "〜を割引する", "〜について話し合う"], answer: 2, explain: "We discussed the plan.（私たちは計画について話し合った）。discuss の後ろに about は不要" },
  { label: "【英語・高校受験】", q: "「earn」の意味は？", choices: ["〜を稼ぐ", "〜を学ぶ", "〜を聞く"], answer: 0, explain: "He earns 3,000 yen an hour.（彼は時給3000円を稼ぐ）" },
  { label: "【英語・高校受験】", q: "「exchange」の意味は？", choices: ["〜を交換する", "〜を伸ばす", "〜を輸出する"], answer: 0, explain: "Let's exchange email addresses.（メールアドレスを交換しよう）" },
  { label: "【英語・高校受験】", q: "「escape」の意味は？", choices: ["逃げる", "〜を探検する", "〜を見積もる"], answer: 0, explain: "The prisoner escaped.（その囚人は逃げた）" },
  { label: "【英語・高校受験】", q: "「guess」の意味は？", choices: ["〜を推測する", "〜を案内する", "〜を守る"], answer: 0, explain: "Guess what happened.（何が起こったと思う？）" },
  { label: "【英語・高校受験】", q: "「ignore」の意味は？", choices: ["〜を想像する", "〜を怒らせる", "〜を無視する"], answer: 2, explain: "She ignored my message.（彼女は私のメッセージを無視した）" },
  { label: "【英語・高校受験】", q: "Does the price ( ) breakfast? 空所に入る語（句）は？", choices: ["increase", "introduce", "include"], answer: 2, explain: "include は「〜を含む」。（料金に朝食は含まれますか）" },
  { label: "【英語・高校受験】", q: "「増える、〜を増やす」を表す英語は？", choices: ["decrease", "increase", "introduce"], answer: 1, explain: "The population is increasing.（人口は増えている）。反対は decrease" },
  { label: "【英語・高校受験】", q: "「mention」の意味は？", choices: ["〜を維持する", "〜を直す", "〜に言及する"], answer: 2, explain: "He didn't mention the problem.（彼はその問題に触れなかった）" },
  { label: "【英語・高校受験】", q: "「notice」の意味は？", choices: ["〜を拒む", "〜に気づく", "〜を訂正する"], answer: 1, explain: "I noticed a strange smell.（変なにおいに気づいた）" },
  { label: "【英語・高校受験】", q: "「prefer」の意味は？", choices: ["〜を準備する", "〜のほうを好む", "〜を予測する"], answer: 1, explain: "I prefer tea to coffee.（コーヒーより紅茶が好きだ）。prefer A to B" },
  { label: "【英語・高校受験】", q: "Heavy snow can ( ) trains from running. 空所に入る語（句）は？", choices: ["include", "prevent", "reduce"], answer: 1, explain: "prevent A from 〜ing で「Aが〜するのを防ぐ」" },
  { label: "【英語・高校受験】", q: "「recognize」の意味は？", choices: ["〜を記録する", "〜を推薦する", "〜だとわかる、〜を認める"], answer: 2, explain: "I recognized her voice.（彼女の声だとわかった）" },
  { label: "【英語・高校受験】", q: "「reduce」の意味は？", choices: ["〜を生産する", "〜を減らす", "〜を再利用する"], answer: 1, explain: "We should reduce waste.（ごみを減らすべきだ）" },
  { label: "【英語・高校受験】", q: "「require」の意味は？", choices: ["〜を必要とする", "〜を研究する", "〜を修理する"], answer: 0, explain: "This job requires patience.（この仕事は忍耐を必要とする）" },
  { label: "【英語・高校受験】", q: "「accident」の意味は？", choices: ["同意", "事故", "成績"], answer: 1, explain: "He had a car accident.（彼は交通事故にあった）" },
  { label: "【英語・高校受験】", q: "「利点、強み」を表す英語は？", choices: ["adventure", "address", "advantage"], answer: 2, explain: "Living in a city has many advantages.（都会に住むことには多くの利点がある）。反対は disadvantage" },
  { label: "【英語・高校受験】", q: "「attention」の意味は？", choices: ["注意", "到着", "意図"], answer: 0, explain: "Pay attention to the teacher.（先生の話に注意しなさい）" },
  { label: "【英語・高校受験】", q: "「character」の意味は？", choices: ["首都", "性格、登場人物", "小切手"], answer: 1, explain: "She has a strong character.（彼女は強い性格だ）" },
  { label: "【英語・高校受験】", q: "「comment」の意味は？", choices: ["委員会", "コメント、意見", "商業"], answer: 1, explain: "Please leave a comment.（コメントを残してください）" },
  { label: "【英語・高校受験】", q: "「群衆、人ごみ」を表す英語は？", choices: ["crown", "crowd", "cloud"], answer: 1, explain: "There was a big crowd at the station.（駅は大勢の人でにぎわっていた）" },
  { label: "【英語・高校受験】", q: "「detail」の意味は？", choices: ["詳細", "防衛", "破壊"], answer: 0, explain: "Please tell me the details.（詳しく教えてください）" },
  { label: "【英語・高校受験】", q: "「努力」を表す英語は？", choices: ["effort", "effect", "exit"], answer: 0, explain: "Make an effort to study every day.（毎日勉強する努力をしなさい）。effect は「効果」" },
  { label: "【英語・高校受験】", q: "「goal」の意味は？", choices: ["金", "目標、ゴール", "ガラス"], answer: 1, explain: "Her goal is to become a doctor.（彼女の目標は医者になることだ）" },
  { label: "【英語・高校受験】", q: "「knowledge」の意味は？", choices: ["知り合い", "知識", "大学"], answer: 1, explain: "He has a lot of knowledge about cars.（彼は車についての知識が豊富だ）。k は発音しない" },
  { label: "【英語・高校受験】", q: "「memory」の意味は？", choices: ["記憶、思い出", "記念碑", "会員"], answer: 0, explain: "I have a good memory.（私は記憶力がいい）" },
  { label: "【英語・高校受験】", q: "「nature」の意味は？", choices: ["栄養", "自然、本質", "国家"], answer: 1, explain: "I love nature.（私は自然が大好きだ）。nation は「国家」" },
  { label: "【英語・高校受験】", q: "「騒音、物音」を表す英語は？", choices: ["noise", "nose", "north"], answer: 0, explain: "Don't make so much noise.（そんなに騒がないで）" },
  { label: "【英語・高校受験】", q: "I felt a sharp ( ) in my back. 空所に入る語（句）は？", choices: ["paint", "page", "pain"], answer: 2, explain: "pain は「痛み」。paint は「塗料」" },
  { label: "【英語・高校受験】", q: "「purpose」の意味は？", choices: ["目的", "追跡", "利益"], answer: 0, explain: "What is the purpose of your visit?（訪問の目的は何ですか）" },
  { label: "【英語・高校受験】", q: "「質」を表す英語は？", choices: ["quality", "quantity", "quarter"], answer: 0, explain: "Quality is more important than quantity.（質は量より大切だ）。quantity は「量」" },
  { label: "【英語・高校受験】", q: "「trouble」の意味は？", choices: ["旅行", "信頼", "困りごと、面倒"], answer: 2, explain: "I'm in trouble.（困ったことになっている）" },
  { label: "【英語・高校受験】", q: "Please tell me the ( ). 空所に入る語（句）は？", choices: ["tooth", "truth", "tree"], answer: 1, explain: "tell the truth は「本当のことを言う」" },
  { label: "【英語・高校受験】", q: "「ordinary」の意味は？", choices: ["ふつうの", "特別な", "順番の"], answer: 0, explain: "an ordinary day（ふつうの日）" },
  { label: "【英語・高校受験】", q: "I'm ( ) of my son. 空所に入る語（句）は？", choices: ["proudly", "pride", "proud"], answer: 2, explain: "be proud of 〜 は「〜を誇りに思う」。名詞は pride" },
  { label: "【英語・高校受験】", q: "「rare」の意味は？", choices: ["まれな、めずらしい", "生の", "公平な"], answer: 0, explain: "a rare bird（めずらしい鳥）" },
  { label: "【英語・高校受験】", q: "「similar」の意味は？", choices: ["簡単な", "安全な", "似ている"], answer: 2, explain: "Your bag is similar to mine.（あなたのバッグは私のに似ている）。be similar to 〜" },
  { label: "【英語・高校受験】", q: "「upset」の意味は？", choices: ["落ち着いた", "動揺した、腹を立てた", "眠い"], answer: 1, explain: "She was upset about the result.（彼女は結果に動揺した）" },
  { label: "【英語・高校受験】", q: "「valuable」の意味は？", choices: ["変わりやすい", "価値のある、貴重な", "利用できる"], answer: 1, explain: "Time is valuable.（時間は貴重だ）" },
  { label: "【英語・高校受験】", q: "「wise」の意味は？", choices: ["広い", "弱い", "賢明な"], answer: 2, explain: "a wise decision（賢明な決断）" },
  { label: "【英語・高校受験】", q: "「absent」の意味は？", choices: ["欠席の", "抽象的な", "絶対の"], answer: 0, explain: "He was absent from school yesterday.（彼は昨日学校を休んだ）。反対は present" },
  { label: "【英語・高校受験】", q: "「common」の意味は？", choices: ["喜劇の", "委員会の", "ふつうの、共通の"], answer: 2, explain: "Smith is a common name.（スミスはよくある名前だ）" },
  { label: "【英語・高校受験】", q: "「curious」の意味は？", choices: ["怒った", "好奇心の強い", "退屈な"], answer: 1, explain: "Children are curious about everything.（子どもは何にでも好奇心を持つ）" },
  { label: "【英語・高校受験】", q: "「probably」の意味は？", choices: ["たぶん", "確実に", "めったに〜ない"], answer: 0, explain: "It will probably rain tomorrow.（明日はたぶん雨だ）" },
  { label: "【英語・高校受験】", q: "「therefore」の意味は？", choices: ["それゆえに", "しかしながら", "そのうえ"], answer: 0, explain: "I think, therefore I am.（我思う、ゆえに我あり）" },
  { label: "【英語・高校受験】", q: "「otherwise」の意味は？", choices: ["その代わりに", "もっと早く", "さもないと"], answer: 2, explain: "Hurry up, otherwise you'll be late.（急ぎなさい。さもないと遅れるよ）" },
  { label: "【英語・高校受験】", q: "「meanwhile」の意味は？", choices: ["やがて", "ついに", "そのあいだに"], answer: 2, explain: "Meanwhile, he was cooking dinner.（そのあいだ、彼は夕食を作っていた）" },

// ===== 英語（高校受験）201〜300問 =====
  { label: "【英語・高校受験】", q: "「be proud of 〜」の意味は？", choices: ["〜を恥じる", "〜を心配する", "〜を誇りに思う"], answer: 2, explain: "I'm proud of my team.（私はチームを誇りに思っている）。反対は be ashamed of 〜" },
  { label: "【英語・高校受験】", q: "「（辞書などで）〜を調べる」を表す英語は？", choices: ["look into", "look up", "look out"], answer: 1, explain: "Look up the word in a dictionary.（その単語を辞書で調べなさい）" },
  { label: "【英語・高校受験】", q: "「look into 〜」の意味は？", choices: ["〜を見上げる", "〜を眺める", "〜を調査する"], answer: 2, explain: "The police are looking into the case.（警察はその事件を調べている）" },
  { label: "【英語・高校受験】", q: "「Look out!」の意味は？", choices: ["外を見て！", "気をつけて！", "探して！"], answer: 1, explain: "Look out! A car is coming.（気をつけて！車が来ているよ）" },
  { label: "【英語・高校受験】", q: "She ( ) her mother. They both have long hair. 空所に入る語（句）は？", choices: ["looks like", "looks for", "looks after"], answer: 0, explain: "look like 〜 は「〜に似ている、〜のように見える」" },
  { label: "【英語・高校受験】", q: "「take off」の意味は？", choices: ["着陸する", "出発を遅らせる", "離陸する、（服などを）脱ぐ"], answer: 2, explain: "The plane took off at noon.（飛行機は正午に離陸した）。反対は land（着陸）、put on（着る）" },
  { label: "【英語・高校受験】", q: "「take after 〜」の意味は？", choices: ["〜に似ている（親などに）", "〜の世話をする", "〜を追いかける"], answer: 0, explain: "He takes after his father.（彼は父親に似ている）。血縁関係のある人に使う" },
  { label: "【英語・高校受験】", q: "「take place」の意味は？", choices: ["行われる、起こる", "場所をとる", "席を譲る"], answer: 0, explain: "The festival takes place in August.（その祭りは8月に行われる）。受け身の形にはしない" },
  { label: "【英語・高校受験】", q: "「（電車・バスなどに）乗る」を表す英語は？", choices: ["get off", "get up", "get on"], answer: 2, explain: "Get on the train at Osaka.（大阪で電車に乗りなさい）。get off は「降りる」" },
  { label: "【英語・高校受験】", q: "You should ( ) the bus at the next stop. 空所に入る語（句）は？", choices: ["get off", "get on", "get up"], answer: 0, explain: "get off は「（乗り物から）降りる」。（次の停留所でバスを降りるといい）" },
  { label: "【英語・高校受験】", q: "「get over 〜」の意味は？", choices: ["〜に乗り込む", "〜を乗り越える、〜から回復する", "〜を片づける"], answer: 1, explain: "It took a week to get over my cold.（風邪が治るのに1週間かかった）" },
  { label: "【英語・高校受験】", q: "「get in touch with 〜」の意味は？", choices: ["〜と触れ合う", "〜と出会う", "〜と連絡をとる"], answer: 2, explain: "I'll get in touch with you soon.（すぐに連絡するよ）" },
  { label: "【英語・高校受験】", q: "「go on 〜ing」の意味は？", choices: ["〜しに出かける", "〜し続ける", "〜をやめる"], answer: 1, explain: "He went on talking for an hour.（彼は1時間話し続けた）" },
  { label: "【英語・高校受験】", q: "「go through 〜」の意味は？", choices: ["〜を経験する、〜を通り抜ける", "〜を避ける", "〜を壊す"], answer: 0, explain: "She went through a hard time.（彼女はつらい時期を経験した）" },
  { label: "【英語・高校受験】", q: "「（宿題などを）提出する」を表す英語は？", choices: ["hand in", "hand out", "hand down"], answer: 0, explain: "Please hand in your report by Friday.（金曜日までにレポートを提出してください）。hand out は「配る」" },
  { label: "【英語・高校受験】", q: "「Hold on.」の意味は？", choices: ["がんばって", "ちょっと待って", "動かないで"], answer: 1, explain: "Hold on a minute.（ちょっと待って）。電話で「そのままお待ちください」の意味でも使う" },
  { label: "【英語・高校受験】", q: "「keep in touch」の意味は？", choices: ["連絡を絶つ", "連絡を取り合う", "連絡を待つ"], answer: 1, explain: "Let's keep in touch.（連絡を取り合おう）" },
  { label: "【英語・高校受験】", q: "「let 〜 down」の意味は？", choices: ["〜を降ろす", "〜をがっかりさせる", "〜を休ませる"], answer: 1, explain: "I don't want to let you down.（あなたをがっかりさせたくない）" },
  { label: "【英語・高校受験】", q: "「make up one's mind」の意味は？", choices: ["気持ちを変える", "覚える", "決心する"], answer: 2, explain: "I made up my mind to study abroad.（私は留学すると決心した）" },
  { label: "【英語・高校受験】", q: "「〜を利用する、活用する」を表す英語は？", choices: ["make up for", "make fun of", "make use of"], answer: 2, explain: "Make use of your time.（時間を有効に使いなさい）。make fun of 〜 は「〜をからかう」" },
  { label: "【英語・高校受験】", q: "「on purpose」の意味は？", choices: ["偶然に", "急いで", "わざと"], answer: 2, explain: "He broke the cup on purpose.（彼はわざとカップを割った）。反対は by accident" },
  { label: "【英語・高校受験】", q: "「by mistake」の意味は？", choices: ["わざと", "間違って", "すぐに"], answer: 1, explain: "I took your umbrella by mistake.（間違ってあなたの傘を持ってきてしまった）" },
  { label: "【英語・高校受験】", q: "I got up early ( ) catch the first train. 空所に入る語（句）は？", choices: ["so that", "in order to", "because of"], answer: 1, explain: "in order to 〜 は「〜するために」（目的）。後ろは動詞の原形" },
  { label: "【英語・高校受験】", q: "「as a result」の意味は？", choices: ["例えば", "ところで", "その結果"], answer: 2, explain: "He studied hard. As a result, he passed the exam.（彼は一生懸命勉強し、その結果、試験に合格した）" },
  { label: "【英語・高校受験】", q: "「on the other hand」の意味は？", choices: ["その結果", "たとえば", "一方で"], answer: 2, explain: "This plan is cheap. On the other hand, it takes a long time.（この計画は安いが、一方で時間がかかる）" },
  { label: "【英語・高校受験】", q: "「in the end」の意味は？", choices: ["結局、最後には", "最初は", "ついでに"], answer: 0, explain: "In the end, we decided to stay home.（結局、私たちは家にいることにした）" },
  { label: "【英語・高校受験】", q: "「for the first time」の意味は？", choices: ["初めて", "最後に", "ひさしぶりに"], answer: 0, explain: "I saw snow for the first time.（私は初めて雪を見た）" },
  { label: "【英語・高校受験】", q: "「from now on」の意味は？", choices: ["今までは", "今後は", "今のところ"], answer: 1, explain: "From now on, I'll get up earlier.（今後は、もっと早く起きます）" },
  { label: "【英語・高校受験】", q: "「right away」の意味は？", choices: ["ずっと前に", "すぐに", "そのうちに"], answer: 1, explain: "Please come right away.（すぐに来てください）" },
  { label: "【英語・高校受験】", q: "「sooner or later」の意味は？", choices: ["早ければ早いほど", "いつでも", "遅かれ早かれ"], answer: 2, explain: "Sooner or later, you'll understand.（遅かれ早かれ、わかるよ）" },
  { label: "【英語・高校受験】", q: "You can stay here ( ) you are quiet. 空所に入る語（句）は？", choices: ["as soon as", "as long as", "as well as"], answer: 1, explain: "as long as 〜 は「〜する限り」（条件）" },
  { label: "【英語・高校受験】", q: "「even if 〜」の意味は？", choices: ["〜でない限り", "たとえ〜でも", "〜かどうか"], answer: 1, explain: "Even if it rains, I'll go.（たとえ雨でも行く）" },
  { label: "【英語・高校受験】", q: "「no longer 〜」の意味は？", choices: ["まだ〜ない", "長くない", "もはや〜ない"], answer: 2, explain: "He no longer lives here.（彼はもうここには住んでいない）" },
  { label: "【英語・高校受験】", q: "I like fruit, ( ) apples and oranges. 空所に入る語（句）は？", choices: ["as well as", "instead of", "such as"], answer: 2, explain: "such as 〜 は「〜のような」（例を挙げる）" },
  { label: "【英語・高校受験】", q: "「be in a hurry」の意味は？", choices: ["心配している", "気に入っている", "急いでいる"], answer: 2, explain: "I'm in a hurry. Let's go.（急いでいるんだ。行こう）" },
  { label: "【英語・高校受験】", q: "「be about to 〜」の意味は？", choices: ["〜するべきだ", "〜したことがある", "まさに〜しようとしている"], answer: 2, explain: "The movie is about to start.（映画が始まろうとしている）" },
  { label: "【英語・高校受験】", q: "You ( ) go to bed early. You look tired. 空所に入る語（句）は？", choices: ["would better", "had better", "should better"], answer: 1, explain: "had better 〜 は「〜したほうがよい」（強めの助言）。後ろは動詞の原形" },
  { label: "【英語・高校受験】", q: "「be supposed to 〜」の意味は？", choices: ["〜することになっている", "〜するふりをする", "〜を想像する"], answer: 0, explain: "I'm supposed to meet him at six.（6時に彼に会うことになっている）" },
  { label: "【英語・高校受験】", q: "「be likely to 〜」の意味は？", choices: ["〜しそうだ", "〜が好きだ", "〜に似ている"], answer: 0, explain: "It is likely to rain tonight.（今夜は雨が降りそうだ）" },
  { label: "【英語・高校受験】", q: "「〜でいっぱいだ」を表す英語は？", choices: ["be made of", "be tired of", "be full of"], answer: 2, explain: "The box is full of toys.（その箱はおもちゃでいっぱいだ）" },
  { label: "【英語・高校受験】", q: "「be tired of 〜」の意味は？", choices: ["〜に興味がある", "〜にうんざりしている", "〜が得意だ"], answer: 1, explain: "I'm tired of the same food every day.（毎日同じ食事にうんざりしている）" },
  { label: "【英語・高校受験】", q: "「be different from 〜」の意味は？", choices: ["〜に似ている", "〜と同じだ", "〜と違う"], answer: 2, explain: "My opinion is different from yours.（私の意見はあなたのとは違う）" },
  { label: "【英語・高校受験】", q: "I was ( ) school this morning. 空所に入る語（句）は？", choices: ["late to", "late for", "late in"], answer: 1, explain: "be late for 〜 は「〜に遅れる」" },
  { label: "【英語・高校受験】", q: "「pay attention to 〜」の意味は？", choices: ["〜に注意を払う", "〜を払い戻す", "〜に気づかない"], answer: 0, explain: "Pay attention to what he says.（彼の言うことに注意を払いなさい）。to のあとは名詞・動名詞" },
  { label: "【英語・高校受験】", q: "「take advantage of 〜」の意味は？", choices: ["〜の世話をする", "〜を利用する、〜につけこむ", "〜を延期する"], answer: 1, explain: "Let's take advantage of the good weather.（いい天気を利用しよう）" },
  { label: "【英語・高校受験】", q: "「turn down 〜」の意味は？", choices: ["〜を回す", "〜を断る、（音量を）下げる", "〜を見下ろす"], answer: 1, explain: "He turned down the job offer.（彼は仕事の申し出を断った）。turn up は「（音量を）上げる」" },
  { label: "【英語・高校受験】", q: "「turn into 〜」の意味は？", choices: ["〜に入る", "〜を回す", "〜に変わる"], answer: 2, explain: "The caterpillar turned into a butterfly.（毛虫はちょうになった）" },
  { label: "【英語・高校受験】", q: "「put off 〜」の意味は？", choices: ["〜を身につける", "〜を延期する", "〜を消す"], answer: 1, explain: "We put off the meeting until next week.（会議を来週に延期した）" },
  { label: "【英語・高校受験】", q: "「set up 〜」の意味は？", choices: ["〜を延期する", "〜を設立する、準備する", "〜を解散する"], answer: 1, explain: "They set up a new company.（彼らは新しい会社を設立した）" },
  { label: "【英語・高校受験】", q: "「show up」の意味は？", choices: ["〜を見せる", "〜を目立たなくする", "現れる"], answer: 2, explain: "He didn't show up at the party.（彼はパーティーに現れなかった）" },
  { label: "【英語・高校受験】", q: "「arrange」の意味は？", choices: ["〜を手配する、整える", "〜を到着させる", "〜を禁止する"], answer: 0, explain: "I'll arrange a meeting.（会議を手配しよう）" },
  { label: "【英語・高校受験】", q: "「〜を引きつける」を表す英語は？", choices: ["attach", "attract", "attack"], answer: 1, explain: "The festival attracts many tourists.（その祭りは多くの観光客を引きつける）。形容詞は attractive" },
  { label: "【英語・高校受験】", q: "「compete」の意味は？", choices: ["〜を保存する", "〜を整理する", "競争する"], answer: 2, explain: "Many companies compete with each other.（多くの会社が競い合っている）。名詞は competition" },
  { label: "【英語・高校受験】", q: "「concentrate」の意味は？", choices: ["〜を集める", "〜を結ぶ", "集中する"], answer: 2, explain: "I can't concentrate on my work.（仕事に集中できない）。concentrate on 〜 の形で使う" },
  { label: "【英語・高校受験】", q: "「consider」の意味は？", choices: ["〜を比べる", "〜に相談する", "〜をよく考える、考慮する"], answer: 2, explain: "Please consider my idea.（私の案を考慮してください）。後ろは名詞か 〜ing" },
  { label: "【英語・高校受験】", q: "「〜を含んでいる」を表す英語は？", choices: ["continue", "contain", "control"], answer: 1, explain: "This bottle contains juice.（このボトルにはジュースが入っている）" },
  { label: "【英語・高校受験】", q: "「deliver」の意味は？", choices: ["〜を提案する", "〜を預ける", "〜を配達する"], answer: 2, explain: "They deliver the mail every morning.（彼らは毎朝郵便を配達する）" },
  { label: "【英語・高校受験】", q: "「deny」の意味は？", choices: ["〜を認める", "〜を否定する", "〜を守る"], answer: 1, explain: "He denied the story.（彼はその話を否定した）" },
